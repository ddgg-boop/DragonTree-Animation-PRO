section{padding:90px 6vw;position:relative}
.sub{text-align:center;color:var(--mu);max-width:640px;margin:0 auto 46px}
.eyebrow{display:block;text-align:center;letter-spacing:.35em;font-size:.72rem;color:var(--lime);margin-bottom:12px}
nav{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:12px 4vw;padding-top:calc(12px + env(safe-area-inset-top,0px));background:rgba(7,16,11,.7);backdrop-filter:blur(14px);border-bottom:1px solid #b6ff2e22}
