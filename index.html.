nav ul a:hover:after{width:100%}
#burger{display:none;background:none;border:1px solid var(--lime);color:var(--lime);border-radius:8px;padding:4px 10px;font-size:1.2rem}
@media(max-width:1100px){#burger{display:block}nav ul{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;background:#07100bf5;padding:16px 6vw}nav ul.open{display:flex}}
.btn{display:inline-block;position:relative;overflow:hidden;border:0;cursor:pointer;font:600 .8rem Outfit,sans-serif;letter-spacing:.14em;color:#2a1c00;text-decoration:none;padding:14px 28px;border-radius:12px;background:linear-gradient(135deg,var(--g1),var(--g2) 45%,var(--g3));box-shadow:0 0 0 1px #fff3b066 inset,0 6px 24px #e8b92355;transition:.3s}
.btn:before{content:"";position:absolute;top:0;left:-70%;width:40%;height:100%;background:linear-gradient(100deg,transparent,#fff9,transparent);transform:skewX(-20deg);transition:.7s}
