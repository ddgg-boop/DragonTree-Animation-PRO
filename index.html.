#hero{min-height:100vh;display:flex;align-items:center;padding-top:110px;background:radial-gradient(ellipse at 70% 40%,#1c3d12 0,transparent 60%),radial-gradient(ellipse at 20% 90%,#0e2a1d,transparent 55%),var(--bg);overflow:hidden}
#fx{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.hero-in{position:relative;display:grid;grid-template-columns:1.1fr 1fr;gap:30px;align-items:center;width:100%;max-width:1250px;margin:auto}
@media(max-width:900px){.hero-in{grid-template-columns:1fr;text-align:center}.hero-in .btns{justify-content:center}}
h1{font-size:clamp(2.8rem,8vw,6.2rem);letter-spacing:.02em;background:linear-gradient(180deg,#eaffb0,var(--lime) 55%,var(--lime2));-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 22px #b6ff2e44)}
.lema{font:italic 500 clamp(1.2rem,2.6vw,1.9rem) 'Cormorant Garamond',serif;color:var(--g1);margin:14px 0}
.btns{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}
#heroart{width:100%;max-width:560px;margin:auto;filter:drop-shadow(0 0 40px #b6ff2e33)}
.scr{fill:none;stroke:#e8f2e6;stroke-width:2.5;stroke-linecap:round;stroke-dasharray:900;stroke-dashoffset:900;animation:dr 3.2s ease forwards}
.tree{opacity:0;animation:fi 2s 2.6s ease forwards}.tree path{fill:none;stroke:var(--lime);stroke-width:3;stroke-linecap:round}
.leaf{fill:var(--lime);opacity:.85;animation:tw 3s infinite alternate}
@keyframes dr{to{stroke-dashoffset:0}}@keyframes fi{to{opacity:1}}@keyframes tw{to{opacity:.35;transform:scale(1.25)}}
.leaf{transform-box:fill-box;transform-origin:center}
.flow{display:flex;gap:0;max-width:1150px;margin:auto;flex-wrap:wrap;justify-content:center}
.step{flex:1;min-width:170px;text-align:center;padding:26px 14px;position:relative}
.step i{display:grid;place-items:center;width:64px;height:64px;margin:0 auto 14px;border-radius:50%;font-style:normal;font-size:1.5rem;border:1px solid var(--lime);background:var(--card);box-shadow:0 0 22px #b6ff2e33;transition:.4s}
.step:hover i{transform:scale(1.15) rotate(8deg);box-shadow:0 0 34px #b6ff2e88}
.step:not(:last-child):after{content:"→";position:absolute;right:-8px;top:42px;color:var(--g2);font-size:1.4rem}
.step.ob i{border-color:#ff7a59;box-shadow:0 0 22px #ff7a5933}
.step h3{font-size:1.3rem;color:var(--g1)}.step p{font-size:.85rem;color:var(--mu)}
.quote{text-align:center;font:italic 500 1.6rem 'Cormorant Garamond',serif;color:var(--lime);margin-top:40px}
.grid{display:grid;gap:22px;max-width:1250px;margin:auto;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.card{background:linear-gradient(160deg,var(--card),#0a150f);border:1px solid #b6ff2e22;border-radius:18px;padding:26px;transition:.4s;position:relative;overflow:hidden}
.card:hover{transform:translateY(-8px) rotateX(3deg);border-color:var(--lime);box-shadow:0 18px 50px #b6ff2e1f}
.card .ic{width:54px;height:54px;border-radius:14px;display:grid;place-items:center;font-size:1.5rem;margin-bottom:14px;color:var(--bg);background:linear-gradient(135deg,var(--lime),var(--lime2))}
.card h3{font-size:1.5rem;margin-bottom:6px}.card p{color:var(--mu);font-size:.9rem;margin-bottom:16px}
#proceso{background:var(--bg2)}
.tl{max-width:900px;margin:auto;position:relative;padding-left:34px;border-left:2px solid #b6ff2e44}
.tli{position:relative;padding:14px 20px;margin-bottom:14px;border-radius:14px;cursor:pointer;transition:.3s;background:#ffffff06}
.tli:before{content:"";position:absolute;left:-44px;top:24px;width:16px;height:16px;border-radius:50%;background:var(--bg);border:2px solid var(--lime);transition:.3s}
.tli.on,.tli:hover{background:#b6ff2e12}.tli.on:before{background:var(--lime);box-shadow:0 0 16px var(--lime)}
.tli b{font:700 1.6rem 'Cormorant Garamond',serif;color:var(--lime)}.tli span{font-size:1.15rem;margin-left:10px;letter-spacing:.1em}
.tli p{max-height:0;overflow:hidden;color:var(--mu);transition:.4s}.tli.on p{max-height:100px;margin-top:6px}
.eco{display:grid;grid-template-columns:1fr 1fr;gap:30px;max-width:1100px;margin:auto;align-items:center}
@media(max-width:800px){.eco{grid-template-columns:1fr}}
.eco svg{width:100%}.eco line{stroke:var(--lime);stroke-width:1.5;stroke-dasharray:6 6;animation:fl 1.5s linear infinite}
@keyframes fl{to{stroke-dashoffset:-24}}
.dash{background:var(--card);border:1px solid #b6ff2e33;border-radius:16px;padding:20px}
.dash div{padding:12px 0;border-bottom:1px solid #ffffff10}.dash div:last-child{border:0}.dash b{color:var(--g1);display:block}
.bar{height:6px;border-radius:4px;background:#ffffff14;margin-top:8px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--lime2),var(--lime));transition:2s}
.rev.in .bar i{width:var(--w)}
.orb{position:relative;max-width:900px;margin:auto;display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;align-items:center}
.orb .core{grid-column:2;grid-row:1/3;display:grid;place-items:center}
.orb .core svg{width:100%;max-width:240px;animation:fl2 6s ease-in-out infinite alternate}
@keyframes fl2{to{transform:translateY(-14px)}}
.orb .card{padding:18px;text-align:center;animation:fl2 5s ease-in-out infinite alternate}.orb .card:nth-child(even){animation-delay:-2s}
@media(max-width:700px){.orb{grid-template-columns:1fr 1fr}.orb .core{grid-column:1/3;grid-row:auto}}
.filters{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}
.filters button{background:none;border:1px solid #b6ff2e55;color:var(--tx);padding:8px 18px;border-radius:30px;cursor:pointer;font:400 .75rem Outfit;letter-spacing:.14em;transition:.3s}
.filters button.on,.filters button:hover{background:var(--lime);color:var(--bg)}
.pf{height:300px;padding:0;cursor:pointer}
.pf .art{position:absolute;inset:0;transition:.7s}.pf:hover .art{transform:scale(1.15) rotate(2deg)}
.pf .info{position:absolute;left:0;right:0;bottom:0;padding:20px;background:linear-gradient(transparent,#050b07f2 60%)}
.pf .tag{font-size:.65rem;letter-spacing:.2em;color:var(--lime)}.pf h3{font-size:1.5rem}
.pf .more{max-height:0;overflow:hidden;opacity:0;transition:.5s;color:var(--mu);font-size:.85rem}.pf:hover .more{max-height:90px;opacity:1;margin-top:6px}
.tcard .av{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font:700 1.3rem 'Cormorant Garamond';color:var(--bg);background:linear-gradient(135deg,var(--g1),var(--g2));margin-bottom:12px}
.st{color:var(--g2);letter-spacing:4px;text-shadow:0 0 10px #e8b92388}
.tcard small{color:var(--lime);display:block;margin-bottom:8px}
.plans{align-items:stretch}.plan{display:flex;flex-direction:column}.plan.top{border-color:var(--g2);box-shadow:0 0 40px #e8b92322}
.plan .pr{font:700 2.1rem 'Cormorant Garamond';color:var(--g1);margin:8px 0}.plan .pr small{font:300 .8rem Outfit;color:var(--mu)}
.plan ul{list-style:none;padding:0;margin:12px 0 20px;flex:1}.plan li{padding:6px 0;border-bottom:1px solid #ffffff0d;font-size:.88rem}.plan li:before{content:"✦ ";color:var(--lime)}
.cond{max-width:1000px;margin:34px auto 0;padding:20px;border:1px dashed var(--g2);border-radius:14px;display:flex;gap:26px;justify-content:center;flex-wrap:wrap;text-align:center;font-size:.9rem}
.cond b{color:var(--g1);font:700 1.6rem 'Cormorant Garamond';display:block}
#talento{background:radial-gradient(ellipse at 50% 50%,#1d3d10,transparent 65%),var(--bg2);text-align:center}
#talento h2{font-size:clamp(2.2rem,6vw,4.4rem)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:40px;max-width:1100px;margin:auto;align-items:center}
@media(max-width:800px){.two{grid-template-columns:1fr}}
.mv{padding:22px;border-left:3px solid var(--lime);background:#ffffff06;border-radius:0 14px 14px 0;margin-bottom:18px}.mv h3{color:var(--lime);letter-spacing:.2em;font-size:1.1rem}
form{max-width:760px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:14px}
form .f{grid-column:1/3}@media(max-width:600px){form{grid-template-columns:1fr}form .f{grid-column:1}}
label{font-size:.72rem;letter-spacing:.14em;color:var(--mu);display:block;margin-bottom:4px}
input,select,textarea{width:100%;padding:12px 14px;background:#0a150f;border:1px solid #b6ff2e33;border-radius:10px;color:var(--tx);font:300 .95rem Outfit;transition:.3s}
input:focus,select:focus,textarea:focus{outline:0;border-color:var(--lime);box-shadow:0 0 14px #b6ff2e44}
#ok{display:none;grid-column:1/-1;text-align:center;color:var(--lime);font:italic 1.5rem 'Cormorant Garamond'}
footer{padding:50px 6vw 36px;background:#050b07;border-top:1px solid #b6ff2e22;text-align:center}
footer .links{display:flex;gap:22px;justify-content:center;flex-wrap:wrap;margin:18px 0}footer a{color:var(--mu);text-decoration:none;font-size:.85rem}footer a:hover{color:var(--lime)}
.rev{opacity:0;transform:translateY(40px);transition:1s}.rev.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rev{opacity:1;transform:none}.scr{stroke-dashoffset:0}.tree{opacity:1}}
.brand{display:block;height:auto;filter:drop-shadow(0 0 10px #b6ff2e88) drop-shadow(0 0 2px #fff6)}
nav .brand{height:46px;width:auto}
footer .brand{width:min(260px,70vw);margin:0 auto}
.core .brand,.aboutlogo .brand{width:100%;max-width:340px;margin:auto;animation:fl2 6s ease-in-out infinite alternate}
.logo{display:inline-flex;align-items:center}
</style></head><body>
