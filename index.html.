<section id="recursos" style="background:var(--bg2)"><span class="eyebrow">CAPACIDADES</span><h2>LAS HERRAMIENTAS DETRÁS DE <em>LA MAGIA</em></h2><p class="sub">&nbsp;</p>
<div class="orb" id="ob"></div></section>

