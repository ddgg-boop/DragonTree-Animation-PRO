<form id="fm"><div><label>NOMBRE</label><input required></div><div><label>EMPRESA / PROYECTO</label><input></div><div><label>CORREO</label><input type="email" required></div>
<div><label>TIPO DE PROYECTO</label><select><option>Animación 2D</option><option>Animación 3D</option><option>Motion graphics</option><option>Stop motion</option><option>Marketing / eventos</option><option>Arte conceptual</option><option>Asesoría</option></select></div>
<div class="f"><label>PRESUPUESTO APROXIMADO (COP)</label><select><option>Menos de $1.8M</option><option>$1.8M – $5M</option><option>$5M – $12M</option><option>Más de $12M</option><option>Aún no lo sé</option></select></div>
<div class="f"><label>DESCRIPCIÓN DE LA IDEA</label><textarea rows="4" required></textarea></div><div class="f"><label>ARCHIVO / REFERENCIA</label><input type="file"></div>
<div class="f" style="text-align:center"><button class="btn" type="submit">COMENZAR MI PROYECTO</button></div><p id="ok">✦ ¡Gracias! Tu idea ya está en camino a volverse leyenda. ✦</p></form></section>

<footer><a class="logo" href="#inicio" aria-label="DragonTree Animation"><img class="brand" src="" alt="DragonTree Animation"></a><p class="lema" style="font-size:1.1rem">“Donde el garabato se vuelve leyenda.”</p>
<div class="links"><a href="#servicios">Servicios</a><a href="#portafolio">Portafolio</a><a href="#nosotros">Nosotros</a><a href="#talento">Talento</a><a href="#contacto">Contacto</a><a href="#precios">Términos y condiciones</a><a href="#nosotros">Derechos de autor</a></div>
<small style="color:var(--mu)">© 2026 DragonTree Animation · Colombia · Derechos de autor con contratistas y contratos de licenciamiento con clientes</small></footer>

<script>
const $=s=>document.querySelector(s),H=(el,h)=>$(el).innerHTML=h;
const SV=[["✎","Animación","Personajes y escenas 2D/3D con calidad profesional."],["✺","Marketing creativo","Piezas animadas que conectan marcas con su público."],["▶","Desarrollo audiovisual","Guion, storyboard y producción de principio a fin."],["❖","Arte conceptual","Propuestas visuales aceleradas con herramientas creativas e IA."],["☘","Acompañamiento creativo","Te guiamos para estructurar y madurar tu historia."],["✧","Impulso de nuevos talentos","Mentores, método y oportunidades reales."],["◈","Asesoramiento de proyectos","Planeación, plazos y recursos para tu producción."],["▣","Contenido visual","Motion graphics y contenido para redes cortas."]];
H('#sv',SV.map(s=>`<div class="card rev"><div class="ic">${s[0]}</div><h3>${s[1]}</h3><p>${s[2]}</p><a class="btn sm" href="#contacto">DESCUBRIR</a></div>`).join(''));
const PF=[["Demon-San","Animación","Diseño de personaje","Serie animada: el demonio de ojos ámbar y su historia.","#c2410c,#fbbf24"],["Vexy","Arte conceptual","Hoja de personaje","Exploración de formas, paleta y expresiones.","#6d28d9,#c4b5fd"],["Donx","Audiovisual","Diseño y animación","Compañero felino para una serie web.","#0f766e,#5eead4"],["Elion","Animación","Tabla de personaje","Turnaround completo listo para producción 3D.","#9a3412,#fdba74"],["Campaña Bosque","Marketing","Motion graphics","Pieza animada para redes con identidad de marca.","#166534,#b6ff2e"],["Evento Leyenda","Audiovisual","Cobertura y visuales","Visuales en vivo y video resumen de evento.","#1e3a8a,#93c5fd"]];
const C=["TODOS","ANIMACIÓN","MARKETING","AUDIOVISUAL","ARTE CONCEPTUAL"];
function rp(f){H('#pf',PF.filter(p=>f=="TODOS"||p[1].toUpperCase()==f).map(p=>`<div class="card pf"><div class="art" style="background:radial-gradient(circle at 30% 30%,${p[4].split(',')[1]}55,transparent 45%),linear-gradient(145deg,${p[4].split(',')[0]},#050b07)"><svg viewBox="0 0 100 100" style="width:100%;height:100%;opacity:.35"><path d="M10 80q20-60 40-30t40-40" fill="none" stroke="#fff" stroke-width="1.2"/></svg></div><div class="info"><span class="tag">${p[1].toUpperCase()} · ${p[2].toUpperCase()}</span><h3>${p[0]}</h3><div class="more">${p[3]}</div></div></div>`).join(''))}
H('#fl',C.map((c,i)=>`<button class="${i?'':'on'}">${c}</button>`).join(''));rp("TODOS");
$('#fl').onclick=e=>{if(e.target.tagName!="BUTTON")return;document.querySelectorAll('#fl button').forEach(b=>b.classList.remove('on'));e.target.classList.add('on');rp(e.target.textContent)};
const TL=[["IDEA","El cliente presenta su concepto."],["BRIEF","Se estructura la idea con formatos de brief prediseñados."],["ARTE CONCEPTUAL","Propuestas visuales con herramientas creativas e IA para acelerar la conceptualización."],["PRODUCCIÓN","Los animadores gestionan tareas y activos diarios."],["REVISIÓN","El cliente revisa y aprueba avances en tiempo real."],["ENTREGA","Se finaliza y entrega el proyecto."]];
H('#tl',TL.map((t,i)=>`<div class="tli ${i?'':'on'}"><b>0${i+1}</b><span>${t[0]}</span><p>${t[1]}</p></div>`).join(''));
$('#tl').onclick=e=>{const t=e.target.closest('.tli');if(!t)return;document.querySelectorAll('.tli').forEach(x=>x.classList.remove('on'));t.classList.add('on')};
const RS=[["Capacitación y entrenamiento creativo","❂"],["Red de contactos y mentores senior","❖"],["Propiedad intelectual y metodología","✧"],["Equipos y hardware","▣"],["Software y licencias","◈"],["Infraestructura y plantillas Cloud","☁"]];
const rc=r=>`<div class="card"><div class="ic" style="margin:0 auto 10px">${r[1]}</div><h3 style="font-size:1.1rem">${r[0]}</h3></div>`;
H('#ob',RS.slice(0,3).map(rc).join('')+`<div class="core"><img class="brand" src="" alt="Logotipo DragonTree Animation"></div>`+RS.slice(3).map(rc).join(''));
const TS=[["L","Laura R.","Serie web “Bosque Eterno”","Llegué con un cuaderno lleno de garabatos y salí con mi personaje animado. Vi cada avance en tiempo real."],["M","Mateo C.","Campaña de marca local","Entendieron la identidad de mi marca y la convirtieron en una pieza que sí se compartió en redes."],["V","Valentina S.","Cortometraje 2D","El brief prediseñado me ordenó la historia; los mentores hicieron el resto."]];
H('#ts',TS.map(t=>`<div class="card tcard rev"><div class="av">${t[0]}</div><div class="st">★★★★★</div><h3>${t[1]}</h3><small>${t[2]}</small><p style="color:var(--mu);font-size:.92rem">“${t[3]}”</p></div>`).join(''));
const PL=[["PLAN ESENCIAL","Para proyectos que están comenzando.","$300 mil","desde","Motion graphics (1–2 semanas)|1 entregable|Brief prediseñado|2 cambios gratis por video|Tablero de avance en línea",0],["PLAN CREATIVO","Para proyectos que necesitan desarrollo visual y producción.","$1.8M","desde / min","Animación 2D (3–4 semanas)|Arte conceptual con IA|Hasta 3 entregables|2 cambios gratis por video|Revisión en tiempo real",1],["PLAN LEYENDA","Acompañamiento integral para proyectos audiovisuales.","$5M","desde / min","Animación 3D (6–8 semanas)|Asesoría y mentoría senior|Entregables a medida|2 cambios gratis por video|Gestión de plazos y recursos",0]];
H('#pl',PL.map(p=>`<div class="card plan rev ${p[5]?'top':''}"><h3>${p[0]}</h3><p style="margin:0;font-size:.85rem">${p[1]}</p><div class="pr">${p[2]} <small>${p[3]}</small></div><ul>${p[4].split('|').map(x=>`<li>${x}</li>`).join('')}</ul><a class="btn" href="#contacto" style="text-align:center">ELEGIR PLAN</a></div>`).join('')+`<div class="card plan rev"><h3>A MEDIDA</h3><p style="margin:0;font-size:.85rem">Stop motion, eventos o producciones complejas.</p><div class="pr">Cotiza <small>sin compromiso</small></div><ul><li>Stop motion: $4M–$8M / min</li><li>Eventos: $150 mil–$1.2M</li><li>Alcance y tiempos a convenir</li></ul><a class="btn ghost" href="#contacto" style="text-align:center">SOLICITAR ASESORÍA</a></div>`);
$('#burger').onclick=()=>$('#menu').classList.toggle('open');$('#menu').onclick=()=>$('#menu').classList.remove('open');
$('#fm').onsubmit=e=>{e.preventDefault();$('#ok').style.display='block'};
const io=new IntersectionObserver(es=>es.forEach(x=>x.isIntersecting&&x.target.classList.add('in')),{threshold:.15});
document.querySelectorAll('.rev').forEach(x=>io.observe(x));
const cv=$('#fx'),cx=cv.getContext('2d');let P=[],W,Hh;
function rz(){W=cv.width=cv.offsetWidth;Hh=cv.height=cv.offsetHeight;P=Array.from({length:70},()=>({x:Math.random()*W,y:Math.random()*Hh,r:Math.random()*2+.5,v:Math.random()*.4+.1,g:Math.random()<.35}))}
rz();addEventListener('resize',rz);
(function a(){cx.clearRect(0,0,W,Hh);P.forEach(p=>{p.y-=p.v;if(p.y<-5){p.y=Hh+5;p.x=Math.random()*W}cx.beginPath();cx.arc(p.x,p.y,p.r,0,7);cx.fillStyle=p.g?'#ffd24dcc':'#b6ff2eaa';cx.shadowBlur=10;cx.shadowColor=cx.fillStyle;cx.fill()});requestAnimationFrame(a)})();
addEventListener('scroll',()=>{const y=scrollY;if(y<innerHeight)$('#heroart').style.transform=`translateY(${y*.12}px)`});
</script><script>const LOGO="data:image/png;base64,";document.querySelectorAll(".brand").forEach(i=>i.src=LOGO)</script></body></html>
