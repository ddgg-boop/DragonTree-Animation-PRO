<style>
:root{--lime:#b6ff2e;--lime2:#7fd400;--bg:#07100b;--bg2:#0d1a12;--card:#11221a;--tx:#e8f2e6;--mu:#9bb3a3;--g1:#fff3b0;--g2:#e8b923;--g3:#9a6b0a;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}html{scroll-behavior:smooth;scroll-padding-top:70px}
body{background:var(--bg);color:var(--tx);font:300 16px/1.6 Outfit,system-ui,sans-serif;overflow-x:hidden}
